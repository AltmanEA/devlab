# Защита от случайного коммита, если каталог git/ используется отдельно.
# Основная игнор-логика — в корневом .gitignore.

# Приватные SSH-ключи, публичные ключи и известные хосты
.ssh/id_*
.ssh/*.pub
.ssh/known_hosts

# Персональный git-конфиг и хранилище учётных данных
.gitconfig
.git-credentials
